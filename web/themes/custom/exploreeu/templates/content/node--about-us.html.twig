{#
/**
 * About Us page
 */
#}

<article{{ attributes.addClass('about-page') }}>

  {{ title_prefix }}
  {{ title_suffix }}

    <section class="about-page__hero">
      <div class="about-page__hero-content">

        <div class="about-page__eyebrow">
          About ExploreEU
        </div>

        <h1 class="about-page__title">
          Travel Europe with confidence
        </h1>

        <p class="about-page__lead">
          ExploreEU is a travel platform created for Erasmus students,
          university students, and young travelers who want to discover
          Europe in a simpler, smarter, and more affordable way.
        </p>

      </div>
    </section>


    <section class="about-page__section">
      <div class="about-page__two-column">

        <div>
          <div class="about-page__section-label">
            Our mission
          </div>

          <h2>
            Making European travel easier for students
          </h2>

          <p>
            Planning a trip should be exciting, not overwhelming.
            ExploreEU brings useful travel information, destination
            inspiration, transportation options, and planning tools
            together in one place.
          </p>

          <p>
            Our goal is to help young travelers make informed decisions,
            discover new destinations, and enjoy more of Europe while
            staying within their budget.
          </p>
        </div>

        <div class="about-page__highlight">
          <span class="about-page__highlight-icon">🌍</span>
 
          <h3>
            Explore more. Plan smarter.
          </h3>

          <p>
            From weekend trips to Erasmus adventures, ExploreEU helps
            make every journey easier to organize.
          </p>
        </div>

      </div>
    </section>


    <section class="about-page__section about-page__section--soft">

      <div class="about-page__section-heading">
        <div class="about-page__section-label">
          What we offer
        </div>

        <h2>
          Everything you need for your next journey
        </h2>

        <p>
          Explore destinations, learn from other travelers,
          and organize your trip with practical tools.
        </p>
      </div>


      <div class="about-page__cards">

        <div class="about-page__card">
          <div class="about-page__card-icon">🗺️</div>

          <h3>Destination Guides</h3>

          <p>
            Discover European cities and find useful information
            before you travel.
          </p>
        </div>


        <div class="about-page__card">
          <div class="about-page__card-icon">✈️</div>

          <h3>Trip Planning</h3>

          <p>
            Compare transportation, accommodation, and weather
            information while building your journey.
          </p>
        </div>


        <div class="about-page__card">
          <div class="about-page__card-icon">💶</div>

          <h3>Budget-Friendly Travel</h3>

          <p>
            Find practical information designed around student
            budgets and affordable travel.
          </p>
        </div>


        <div class="about-page__card">
          <div class="about-page__card-icon">💬</div>

          <h3>Traveler Community</h3>

          <p>
            Read real experiences and travel tips shared by
            other members of the ExploreEU community.
          </p>
        </div>

      </div>

    </section>


    <section class="about-page__section">

      <div class="about-page__why">

        <div>
          <div class="about-page__section-label">
            Why ExploreEU?
          </div>

          <h2>
            Built around the way young people travel
          </h2>
        </div>

        <div>
          <p>
            ExploreEU combines travel inspiration, community knowledge,
            and interactive planning tools in a single platform.
          </p>

          <p>
            Whether you are preparing for Erasmus, planning a weekend
            getaway, or exploring another European city, ExploreEU is
            designed to make the process simpler.
          </p>
        </div>

      </div>

    </section>
  
</article>
