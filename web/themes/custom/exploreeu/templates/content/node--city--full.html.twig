<article{{ attributes.addClass('city-detail-page') }}>

  {# HERO #}
  <section class="city-detail-hero">

    {% if node.field_city_hero_image.entity %}
      <div class="city-detail-hero-image">
        {{ content.field_city_hero_image }}
      </div>
    {% endif %}

    <div class="city-detail-hero-overlay"></div>

    <div class="city-detail-hero-content">

      {% if node.field_country.entity %}
        <div class="city-detail-country">
          {{ node.field_country.entity.label }}
        </div>
      {% endif %}

      <h1>{{ label }}</h1>

      {% if node.field_short_description.value %}
        <div class="city-detail-intro">
          {{ node.field_short_description.value|raw }}
        </div>
      {% endif %}

    </div>

  </section>


  {# QUICK STATS #}
  <section class="city-detail-stats">

    {% if node.field_average_daily_budget.value %}
      <div class="city-stat">
        <span class="city-stat-icon">💶</span>

        <div>
          <strong>
            {{ node.field_average_daily_budget.value|number_format(0) }}
          </strong>
          <span>Daily Budget</span>
        </div>
      </div>
    {% endif %}


    {% if node.field_student_friendly_score.value %}
      <div class="city-stat">
        <span class="city-stat-icon">⭐</span>

        <div>
          <strong>
            {{ node.field_student_friendly_score.value }}/5
          </strong>
          <span>Student Friendly</span>
        </div>
      </div>
    {% endif %}


    {% if node.field_safety_score.value %}
      <div class="city-stat">
        <span class="city-stat-icon">🛡️</span>

        <div>
          <strong>
            {{ node.field_safety_score.value }}/5
          </strong>
          <span>Safety Score</span>
        </div>
      </div>
    {% endif %}


    {% if node.field_minimum_recommended_stay.value
      and node.field_maximum_recommended_stay.value %}

      <div class="city-stat">
        <span class="city-stat-icon">🛏️</span>

        <div>
          <strong>
            {{ node.field_minimum_recommended_stay.value }}
            –
            {{ node.field_maximum_recommended_stay.value }} days
          </strong>
          <span>Recommended Stay</span>
        </div>
      </div>

    {% endif %}

  </section>


  {# EXPERIENCES + COMMUNITY - LAPTOP / TABLET / MOBILE #}
  {% if city_experiences is not empty or city_community %}

    <div class="city-responsive-sidebars">

      {# EXPERIENCES #}
      {% if city_experiences is not empty %}

        <aside class="city-experiences-responsive">

          <div class="city-experiences-sidebar__eyebrow">
            Experiences
          </div>

          <h3>
            Experiences in {{ label }}
          </h3>

          <ul class="city-experiences-list">

            {% for experience in city_experiences %}

              <li>
                <a href="{{ experience.url }}">
                  {{ experience.title }}
                </a>
              </li>

            {% endfor %}

          </ul>

        </aside>

      {% endif %}


      {# COMMUNITY #}
      {% if city_community %}

        <aside class="city-community-responsive">

          <div class="city-community-sidebar__eyebrow">
            Community
          </div>

          <h3>
            Connect in {{ label }}
          </h3>

          <p class="city-community-sidebar__text">
            Meet students and travelers in {{ label }}.
          </p>

          <a
            href="{{ city_community.url }}"
            class="city-community-sidebar__link"
          >

            <strong>
              {{ city_community.title }}
            </strong>

            <span>
              View Community →
            </span>

          </a>


          {% if city_community_events is not empty %}

            <div class="city-community-sidebar__events">

              <div class="city-community-sidebar__events-title">
                Upcoming Events
              </div>

              {% for event in city_community_events %}

                <a
                  href="{{ event.url }}"
                  class="city-community-sidebar__event"
                >

                  <strong>
                    {{ event.title }}
                  </strong>

                  {% if event.start_date %}
                    <span>
                      📅 {{ event.start_date|date('d M Y') }}
                    </span>
                  {% endif %}

                  {% if event.location %}
                    <span>
                      📍 {{ event.location }}
                    </span>
                  {% endif %}

                </a>

              {% endfor %}

            </div>

          {% endif %}

        </aside>

      {% endif %}

    </div>

  {% endif %}


  {# MAIN CONTENT #}
  <div class="city-detail-container">

    <main class="city-detail-main">


      {# ABOUT #}
      {% if node.field_detailed_city_guide.value %}

        <section class="city-detail-section">

          <div class="city-section-heading">
            <span>📍</span>
            <h2>About {{ label }}</h2>
          </div>

          <div class="city-section-body">
            {{ node.field_detailed_city_guide.value|raw }}
          </div>

        </section>

      {% endif %}


      {# TRANSPORTATION #}
      {% if node.field_public_transportation_info.value
        or node.field_transportation_tips.value %}

        <section class="city-detail-section">

          <div class="city-section-heading">
            <span>🚇</span>
            <h2>Transportation</h2>
          </div>

          <div class="city-section-body">

            {% if node.field_public_transportation_info.value %}
              {{ node.field_public_transportation_info.value|raw }}
            {% endif %}

            {% if node.field_transportation_tips.value %}

              <div class="city-info-note">
                {{ node.field_transportation_tips.value|raw }}
              </div>

            {% endif %}

          </div>

        </section>

      {% endif %}


      {# TRAVEL INFORMATION #}
      {% if node.field_internet_sim_information.value
        or node.field_atm_payment_information.value
        or node.field_emergency_information.value %}

        <section class="city-detail-section">

          <div class="city-section-heading">
            <span>🧳</span>
            <h2>Travel Information</h2>
          </div>

          <div class="city-travel-info-grid">


            {% if node.field_internet_sim_information.value %}

              <div class="city-travel-info-card">

                <div class="city-travel-info-card__icon">
                  📱
                </div>

                <div class="city-travel-info-card__content">

                  <h3>Internet & SIM</h3>

                  {{ node.field_internet_sim_information.value|raw }}

                </div>

              </div>

            {% endif %}


            {% if node.field_atm_payment_information.value %}

              <div class="city-travel-info-card">

                <div class="city-travel-info-card__icon">
                  💳
                </div>

                <div class="city-travel-info-card__content">

                  <h3>ATM & Payments</h3>

                  {{ node.field_atm_payment_information.value|raw }}

                </div>

              </div>

            {% endif %}


            {% if node.field_emergency_information.value %}

              <div class="city-travel-info-card">

                <div class="city-travel-info-card__icon">
                  🚨
                </div>

                <div class="city-travel-info-card__content">

                  <h3>Emergency</h3>

                  {{ node.field_emergency_information.value|raw }}

                </div>

              </div>

            {% endif %}

          </div>

        </section>

      {% endif %}


      {# SEMESTER GUIDE #}
      {% if node.field_fall_semester_travel_recom.value
        or node.field_spring_semester_travel_rec.value %}

        <section class="city-detail-section">

          <div class="city-section-heading">
            <span>🎓</span>
            <h2>Semester Travel Guide</h2>
          </div>

          <div class="city-semester-grid">


            {% if node.field_fall_semester_travel_recom.value %}

              <div class="city-semester-card">

                <h3>🍂 Fall Semester</h3>

                {{ node.field_fall_semester_travel_recom.value|raw }}

              </div>

            {% endif %}


            {% if node.field_spring_semester_travel_rec.value %}

              <div class="city-semester-card">

                <h3>🌸 Spring Semester</h3>

                {{ node.field_spring_semester_travel_rec.value|raw }}

              </div>

            {% endif %}

          </div>

        </section>

      {% endif %}

    </main>

  </div>


  {# PHOTO GALLERY #}
  {% if not node.field_photo_gallery.isEmpty %}

    <section class="city-detail-gallery">

      <div class="city-detail-gallery-inner">

        <h2>
          Explore {{ label }}
        </h2>

        {{ content.field_photo_gallery }}

      </div>

    </section>

  {% endif %}

</article>
