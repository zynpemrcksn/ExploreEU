<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;

/**
 * Implements hook_form_FORM_ID_alter() for the user login form.
 */
function exploreeu_form_user_login_form_alter(
  array &$form,
  FormStateInterface $form_state
): void {

  $form['auth_visual_text'] = [
    '#type' => 'markup',
    '#markup' => '
      <div class="auth-visual-text auth-visual-text--login">
        <h2>Welcome to ExploreEU</h2>
        <p>Discover Europe, plan unforgettable journeys, and share your travel experiences.</p>
      </div>
    ',
    '#weight' => -200,
  ];

  $form['login_intro'] = [
    '#type' => 'markup',
    '#markup' => '
      <div class="login-intro">
        <div class="login-icon" aria-hidden="true">🔒</div>
        <h1>Log in</h1>
        <p>Welcome back! Log in to continue your journey.</p>
      </div>
    ',
    '#weight' => -100,
  ];

  $form['forgot_password'] = [
    '#type' => 'link',
    '#title' => t('Forgot your password?'),
    '#url' => Url::fromRoute('user.pass'),
    '#attributes' => [
      'class' => ['login-forgot-link'],
    ],
    '#weight' => 20,
  ];

  $form['signup_prompt'] = [
    '#type' => 'markup',
    '#markup' => '
      <div class="login-signup">
        <span>Don\'t have an account?</span>
        <a href="/user/register">Sign up</a>
      </div>
    ',
    '#weight' => 40,
  ];
  $form['actions']['#weight'] = 30;
}

/**
 * Implements hook_preprocess_html().
 */
function exploreeu_preprocess_html(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();

  if ($route_name === 'user.login') {
    $variables['attributes']['class'][] = 'page-user-login';
  }

  if ($route_name === 'user.register') {
    $variables['attributes']['class'][] = 'page-user-register';
  }

  if ($route_name === 'user.pass') {
    $variables['attributes']['class'][] = 'page-user-password';
  }
  if ($route_name === 'entity.user.canonical') {
    $variables['attributes']['class'][] = 'page-user-account';
  }

  if ($route_name === 'entity.user.edit_form') {
    $variables['attributes']['class'][] = 'page-user-account-edit';
  }
}

/**
 * Implements for register page 
 */
function exploreeu_form_user_register_form_alter(
 array &$form,
 FormStateInterface $form_state
): void {

  $form['auth_visual_text'] = [
    '#type' => 'markup',
    '#markup' => '
      <div class="auth-visual-text auth-visual-text--register">
        <h2>Start your next adventure</h2>
        <p>Plan your journey, discover Europe, and create memories along the way.</p>
      </div>
    ',
    '#weight' => -200,
  ];

  $form['register_intro'] = [
    '#type' => 'markup',
    '#markup' => '
      <div class="login-intro">
        <div class="login-icon" aria-hidden="true">🌍</div>
        <h1>Register</h1>
        <p>Create your ExploreEU account and start your next adventure.</p>
      </div>
    ',
    '#weight' => -100,
  ];
  unset($form['user_picture']);
  $form['account']['mail']['#description'] = '';
  $form['account']['name']['#description'] = '';
  $form['login_prompt']= [
    '#type' => 'markup',
    '#markup' => '
      <div class="register-login-prompt">
        <span>Already have an account?</span>
        <a href="/user/login">Log in</a>
      </div>
    ',
    '#weight' => 40,
   ];
   
   $form['actions']['#weight'] = 30;
}

use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess_breadcrumb().
 *
 * Adds the related listing page between Home and node title
 * for ExploreEU content types.
 */
function exploreeu_preprocess_breadcrumb(array &$variables): void {

  $route_match = \Drupal::routeMatch();

  if ($route_match->getRouteName() === 'entity.node.canonical') {
    $node = $route_match->getParameter('node');

    if ($node instanceof \Drupal\node\NodeInterface && $node->bundle() === 'city') {
      $variables['breadcrumb'] = [
        [
          'text' => 'Home',
          'url' => \Drupal\Core\Url::fromRoute('<front>'),
        ],
        [
          'text' => 'Cities',
          'url' => \Drupal\Core\Url::fromUserInput('/cities'),
        ],
        [
          'text' => $node->label(),
          'url' => NULL,
        ],
      ];

      return;
    }
  }

  $route_match = \Drupal::routeMatch();

  $route_name =
    $route_match->getRouteName();


  if (
    $route_name === 'node.add' &&
    $route_match->getParameter('node_type')?->id() === 'calendar_event'
  ) {

    $variables['breadcrumb'] = [
      [
        'text' => t('Home'),
        'url' => Url::fromRoute('<front>'),
      ],
      [
        'text' => t('Calendar'),
        'url' => Url::fromUserInput('/calendar'),
      ],
      [
        'text' => t('Create Calendar Event'),
      ],
    ];

    return;

  }

  if ($route_name === 'entity.user.edit_form') {
    $user = $route_match->getParameter('user');

    $variables['breadcrumb'] = [
      [
        'text' => t('Home'),
        'url' => Url::fromRoute('<front>'),
      ],
      [
        'text' => t('My Account'),
        'url' => Url::fromRoute(
          'entity.user.canonical',
          ['user' => $user->id()]
        ),
      ],
      [
        'text' => t('Edit'),
      ],
    ];

    return;
  }

  $node = $route_match->getParameter('node');

  // Only customize breadcrumbs on node detail pages.
  if (!$node instanceof NodeInterface) {
    return;
  }

  $bundle = $node->bundle();

  // Define the parent listing page for each content type.
  $parents = [
    'travel_tip' => [
      'title' => t('Travel Tips'),
      'path' => '/travel-tips',
    ],
    'experience' => [
      'title' => t('Experiences'),
      'path' => '/experiences',
    ],
    'city' => [
      'title' => t('Destinations'),
      'path' => '/destinations',
    ],
    'country' => [
      'title' => t('Destinations'),
      'path' => '/destinations',
    ],
    'calendar_event' => [
      'title' => t('Calendar'),
      'path' => '/calendar',
    ],
  ];

  // Leave Drupal's normal breadcrumb untouched
  // for content types we do not customize.
  if (!isset($parents[$bundle])) {
    return;
  }

  $parent = $parents[$bundle];

  $variables['breadcrumb'] = [
    [
      'text' => t('Home'),
      'url' => Url::fromRoute('<front>'),
    ],
    [
      'text' => $parent['title'],
      'url' => Url::fromUserInput($parent['path']),
    ],
    [
      'text' => $node->label(),
    ],
  ];
}

/**
 * Loads experiences related to a city.
 */
function exploreeu_get_city_experiences(\Drupal\node\NodeInterface $node): array {
  static $cache = [];

  $nid = (int) $node->id();

  if (isset($cache[$nid])) {
    return $cache[$nid];
  }

  $experience_ids = \Drupal::entityQuery('node')
    ->condition('type', 'experience')
    ->condition('status', 1)
    ->condition('field_city.target_id', $nid)
    ->accessCheck(TRUE)
    ->sort('created', 'DESC')
    ->execute();

  $cache[$nid] = [];

  if (!empty($experience_ids)) {
    $experiences = \Drupal\node\Entity\Node::loadMultiple($experience_ids);

    foreach ($experiences as $experience) {
      $cache[$nid][] = [
        'title' => $experience->label(),
        'url' => $experience->toUrl()->toString(),
      ];
    }
  }

  return $cache[$nid];
}

/**
 * Loads community related to a city.
 */
function exploreeu_get_city_community(\Drupal\node\NodeInterface $node): ?array {
  static $cache = [];

  $nid = (int) $node->id();

  if (array_key_exists($nid, $cache)) {
    return $cache[$nid];
  }

  $community_ids = \Drupal::entityQuery('node')
    ->condition('type', 'community')
    ->condition('status', 1)
    ->condition('field_city.target_id', $nid)
    ->accessCheck(TRUE)
    ->sort('created', 'DESC')
    ->range(0, 1)
    ->execute();

  $cache[$nid] = NULL;

  if (!empty($community_ids)) {
    $community_id = reset($community_ids);
    $community = \Drupal\node\Entity\Node::load($community_id);

    if ($community) {
      $cache[$nid] = [
        'title' => $community->label(),
        'url' => $community->toUrl()->toString(),
      ];
    }
  }

  return $cache[$nid];
}

/**
 * Loads events related to a community.
 */
function exploreeu_get_community_events(\Drupal\node\NodeInterface $node): array {
  static $cache = [];

  $nid = (int) $node->id();

  if (isset($cache[$nid])) {
    return $cache[$nid];
  }

  $event_ids = \Drupal::entityQuery('node')
    ->condition('type', 'community_event')
    ->condition('status', 1)
    ->condition('field_community.target_id', $nid)
    ->accessCheck(TRUE)
    ->sort('field_event_dates.value', 'ASC')
    ->execute();

  $cache[$nid] = [];

  if (!empty($event_ids)) {
    $events = \Drupal\node\Entity\Node::loadMultiple($event_ids);

    foreach ($events as $event) {
      $cache[$nid][] = [
        'title' => $event->label(),
        'url' => $event->toUrl()->toString(),
        'start_date' => $event->get('field_event_dates')->value,
        'end_date' => $event->get('field_event_dates')->end_value,
        'location' => $event->get('field_event_location')->value,
      ];
    }
  }

  return $cache[$nid];
}

/**
 * Loads upcoming community events related to a city.
 */
function exploreeu_get_city_community_events(\Drupal\node\NodeInterface $node): array {
  static $cache = [];

  $city_nid = (int) $node->id();

  if (isset($cache[$city_nid])) {
    return $cache[$city_nid];
  }

  $cache[$city_nid] = [];

  // Find the community related to this city.
  $community_ids = \Drupal::entityQuery('node')
    ->condition('type', 'community')
    ->condition('status', 1)
    ->condition('field_city.target_id', $city_nid)
    ->accessCheck(TRUE)
    ->sort('created', 'DESC')
    ->range(0, 1)
    ->execute();

  if (empty($community_ids)) {
    return $cache[$city_nid];
  }

  $community_nid = (int) reset($community_ids);

  // Load the nearest upcoming events for this community.
  $event_ids = \Drupal::entityQuery('node')
    ->condition('type', 'community_event')
    ->condition('status', 1)
    ->condition('field_community.target_id', $community_nid)
    ->condition('field_event_dates.end_value', gmdate('Y-m-d\TH:i:s'), '>=')
    ->accessCheck(TRUE)
    ->sort('field_event_dates.value', 'ASC')
    ->range(0, 3)
    ->execute();

  if (empty($event_ids)) {
    return $cache[$city_nid];
  }

  $events = \Drupal\node\Entity\Node::loadMultiple($event_ids);

  foreach ($events as $event) {
    $cache[$city_nid][] = [
      'title' => $event->label(),
      'url' => $event->toUrl()->toString(),
      'start_date' => $event->get('field_event_dates')->value,
      'location' => $event->get('field_event_location')->value,
    ];
  }

  return $cache[$city_nid];
}

/**
 * Implements hook_preprocess_node().
 */
function exploreeu_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;

  if (!$node instanceof \Drupal\node\NodeInterface) {
    return;
  }

  if ($node->bundle() === 'basic_page' && $node->label() === 'Contact') {
    $variables['contact_webform'] = [
      '#type' => 'webform',
      '#webform' => 'contact',
    ];
  }

//only experience page

  if ($node->bundle() === 'experience' && ($variables['view_mode'] ?? '') === 'full') {
    $nid = $node->id();

    $result = \Drupal::database()
      ->select('node_counter', 'nc')
      ->fields('nc', ['totalcount'])
      ->condition('nid', $nid)
      ->execute()
      ->fetchField();

    $variables['experience_view_count'] = $result ?: 0;
  }

  // City detail page: load related experiences and community.
  if ($node->bundle() === 'city' && ($variables['view_mode'] ?? '') === 'full') {
    $variables['city_experiences'] = exploreeu_get_city_experiences($node);
    $variables['city_community'] = exploreeu_get_city_community($node);
  }

  // Community detail page: load related events and membership status.
  if ($node->bundle() === 'community' && ($variables['view_mode'] ?? '') === 'full') {
    $variables['elements']['#cache']['max-age'] = 0;
    $variables['community_events'] = exploreeu_get_community_events($node);
    $variables['community_event_count'] = count($variables['community_events']);

    $variables['community_member_count'] = (int) \Drupal::database()
      ->select('exploreeu_community_membership', 'm')
      ->condition('community_nid', (int) $node->id())
      ->countQuery()
      ->execute()
      ->fetchField();

    $variables['is_community_member'] = FALSE;

    $current_user = \Drupal::currentUser();

    if ($current_user->isAuthenticated()) {
      $membership_id = \Drupal::database()
        ->select('exploreeu_community_membership', 'm')
        ->fields('m', ['id'])
        ->condition('uid', (int) $current_user->id())
        ->condition('community_nid', (int) $node->id())
        ->execute()
        ->fetchField();

      $variables['is_community_member'] = (bool) $membership_id;
    }
  }
}

/**
 * Implements hook_preprocess_page().
 */
function exploreeu_preprocess_page(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();

  // Experiences listing page.
  if ($route_name === 'view.experiences.page_1') {
    $variables['is_experiences_page'] = TRUE;

    $variables['experience_city_filter'] = [
      'All' => 'All Cities',
      '1' => 'Amsterdam',
      '2' => 'Barcelona',
      '3' => 'Berlin',
      '4' => 'Paris',
      '5' => 'Prague',
      '6' => 'Rome',
    ];

    $variables['experience_selected_city'] =
      \Drupal::request()->query->get('field_city_target_id', 'All');
  }

  // City detail pages.
  $node = \Drupal::routeMatch()->getParameter('node');

  if (!$node instanceof \Drupal\node\NodeInterface) {
    return;
  }

  if ($node->bundle() !== 'city') {
    return;
  }

  $variables['city_experiences'] = exploreeu_get_city_experiences($node);
  $variables['city_community'] = exploreeu_get_city_community($node);
  $variables['current_city_title'] = $node->label();
  $variables['city_community_events'] = exploreeu_get_city_community_events($node);
}
/**
 * Implements hook_theme_suggestions_node_alter().
 */
function exploreeu_theme_suggestions_node_alter(array &$suggestions, array $variables): void {
  $node = $variables['elements']['#node'] ?? NULL;

  if (!$node instanceof NodeInterface) {
    return;
  }

  if ($node->label() === 'About Us') {
    $suggestions[] = 'node__about_us';
  }
  if ($node->label() === 'Contact') {
  $suggestions[] = 'node__contact';
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for the password reset form.
 */
function exploreeu_form_user_pass_alter(
  array &$form,
  \Drupal\Core\Form\FormStateInterface $form_state
): void {

  $form['password_intro'] = [
    '#type' => 'markup',
    '#markup' => '
      <div class="password-reset-intro">
        <div class="password-reset-icon" aria-hidden="true">🔑</div>

        <h1>Reset your password</h1>

        <p>
          Enter your username or email address and we\'ll send you reset instructions.
        </p>
      </div>
    ',
    '#weight' => -100,
  ];

  $form['password_login_prompt'] = [
    '#type' => 'markup',
    '#markup' => '
      <div class="password-login-prompt">
        Remember your password?
        <a href="/user/login">Log in</a>
      </div>
    ',
    '#weight' => 100,
  ];
  $form['#submit'][] = 'exploreeu_user_pass_redirect_submit';
}
/**
 * Keep the user on the password reset page after submission.
 */
function exploreeu_user_pass_redirect_submit(
  array &$form,
  \Drupal\Core\Form\FormStateInterface $form_state
): void {
  $form_state->setRedirect('user.pass');
}

