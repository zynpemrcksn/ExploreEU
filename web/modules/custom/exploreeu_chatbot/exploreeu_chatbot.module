<?php

/**
 * Implements hook_page_bottom().
 */
function exploreeu_chatbot_page_bottom(array &$page_bottom): void {
  $page_bottom['exploreeu_chatbot'] = [
    '#type' => 'inline_template',
    '#template' => '
      <div id="exploreeu-chatbot" class="exploreeu-chatbot">
        <button
          id="exploreeu-chatbot-toggle"
          class="exploreeu-chatbot__toggle"
          type="button"
          aria-label="Open ExploreEU Assistant"
        >
          💬
        </button>

        <div
          id="exploreeu-chatbot-panel"
          class="exploreeu-chatbot__panel"
          hidden
        >
          <div class="exploreeu-chatbot__header">
            <div>
              <strong>ExploreEU Assistant</strong>
              <span>Travel smarter around Europe</span>
            </div>

            <button
              id="exploreeu-chatbot-clear"
              class="exploreeu-chatbot__clear"
              type="button"
            >
              Clear
            </button>

            <button
              id="exploreeu-chatbot-close"
              class="exploreeu-chatbot__close"
              type="button"
              aria-label="Close assistant"
            >
              ×
            </button>
          </div>

          <div
            id="exploreeu-chatbot-messages"
            class="exploreeu-chatbot__messages"
            aria-live="polite"
          >
            <div class="exploreeu-chatbot__message exploreeu-chatbot__message--bot">
              Hi! 👋 I’m the ExploreEU Assistant. Ask me about destinations,itineraries, budget travel, transport, food, or Erasmus travel.
            </div>
          </div>

          <form
            id="exploreeu-chatbot-form"
            class="exploreeu-chatbot__form"
          >
            <textarea
              id="exploreeu-chatbot-input"
              class="exploreeu-chatbot__input"
              rows="1"
              maxlength="2000"
              placeholder="Ask about your trip..."
              aria-label="Message"
              required
            ></textarea>

            <button
              class="exploreeu-chatbot__send"
              type="submit"
              aria-label="Send message"
            >
              Send
            </button>
          </form>
        </div>
      </div>
    ',
    '#attached' => [
      'library' => [
        'exploreeu_chatbot/chatbot',
      ],
    ],
  ];
}
